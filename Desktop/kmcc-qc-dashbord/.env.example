# KMCC QC Dashboard 환경 변수 설정
# 이 파일을 복사하여 .env.local로 저장하고 값을 설정하세요

# ========================================
# BigQuery 설정 (필수)
# ========================================
BIGQUERY_PROJECT_ID=splyquizkm
BIGQUERY_DATASET_ID=KMCC_QC
# BigQuery 서비스 계정 JSON 키 (한 줄로 입력)
BIGQUERY_CREDENTIALS={"type":"service_account","project_id":"...","private_key":"..."}

# ========================================
# Google AI (Gemini) 설정 (필수)
# ========================================
# Google AI Studio에서 API 키 발급: https://aistudio.google.com/app/apikey
GOOGLE_AI_API_KEY=your_google_ai_api_key_here
# 모델 선택 (선택사항, 기본값: gemini-2.0-flash-exp)
GOOGLE_AI_MODEL=gemini-2.0-flash-exp

# ========================================
# Google Sheets 설정 (선택)
# ========================================
GOOGLE_SHEETS_ID=14pXr3QNz_xY3vm9QNaF2yOtle1M4dqAuGb7Z5ebpi2o

# ========================================
# Firebase 설정 (deprecated - BigQuery로 대체됨)
# ========================================
# FIREBASE_PROJECT_ID=your_firebase_project_id
# FIREBASE_CLIENT_EMAIL=your_service_account_email
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# FIREBASE_DATABASE_ID=(default)

# ========================================
# 배포 설정
# ========================================
# Vercel 배포 시 자동 설정됨
# NEXT_PUBLIC_BASE_URL=https://kmcc-qc-dashbord-iota.vercel.app
